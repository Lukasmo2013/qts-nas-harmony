{
  "app": {
    // 本地自签 release 签名材料（tools/prepare_signing_config.js 生成）。
    // 上架 AppGallery 前必须替换为 AGC 下发的正式 .p12 / .cer / .p7b 与对应口令。
    "signingConfigs": [
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "release",
        "compatibleSdkVersion": "6.0.0(20)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
