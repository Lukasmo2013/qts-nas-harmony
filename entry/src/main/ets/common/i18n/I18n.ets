/** 取文案；缺失时回退到中文，再回退到 key 本身，保证界面不出现空白。 */
export function t(key: string, lang: string): string {
  const table: Record<string, string> = lang === AppConstants.LANG_EN ? EN : ZH;
  const hit: string | undefined = table[key];
  if (hit !== undefined && hit.length > 0) {
    return hit;
  }
  const fallback: string | undefined = ZH[key];
  return fallback !== undefined ? fallback : key;
}

/** 单参数插值，占位符统一为 %s。 */
export function tf(key: string, lang: string, arg: string): string {
  return t(key, lang).replace('%s', arg);
}

export function currentLang(): string {
  const value: string | undefined = AppStorage.get<string>(AppConstants.APP_STORAGE_LANG);
  return value === AppConstants.LANG_EN ? AppConstants.LANG_EN : AppConstants.LANG_ZH;
}

export function switchLanguage(lang: string): void {
  const next: string = lang === AppConstants.LANG_EN ? AppConstants.LANG_EN : AppConstants.LANG_ZH;
  AppStorage.setOrCreate<string>(AppConstants.APP_STORAGE_LANG, next);
}
